set_global_assignment -name IP_TOOL_NAME "MAX II/MAX V oscillator"
set_global_assignment -name IP_TOOL_VERSION "23.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{MAX V}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "OSCint.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSCint.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSCint_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSCint.cmp"]
