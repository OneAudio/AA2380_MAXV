set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSC_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSC.inc"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "OSC.cmp"]
